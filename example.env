# HTTP listen address. Plain HTTP; the reverse proxy (Traefik) forwards the telemetry Host
# names here and terminates TLS.
PS5_ADDR=:8080

# debug, info, warn or error. info logs one "telemetry" line per request (the hostname census).
# PS5_LOG_LEVEL=info

# Research only, off by default. Writes request headers + the first 4 KiB of the body to one
# file per request in this directory.
# PS5_TELEMETRY_DUMP_DIR=/dump
